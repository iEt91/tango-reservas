# Plantilla sin secretos reales.
# Copiar como .env.local y reemplazar únicamente en el entorno local.

NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key

# Solo servidor. Nunca usar un prefijo NEXT_PUBLIC_.
# Clave server-only moderna (sb_secret_*). No usar NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# Compatibilidad temporal con proyectos que aún usan la JWT legacy service_role.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Solo servidor. Se usa para anonimizar solicitudes públicas sin reutilizar el service role.
PUBLIC_REQUEST_FINGERPRINT_SECRET=replace-with-a-random-32-byte-secret
