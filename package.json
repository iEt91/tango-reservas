{
  "name": "tango-reservas",
  "version": "5.6.0-configuracion-lab",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:availability": "node scripts/availability-regression-tests.mjs",
    "test:stock": "node scripts/stock-regression-tests.mjs",
    "test:tracking": "node scripts/tracking-regression-tests.mjs",
    "test:storage": "node scripts/storage-contract-regression-tests.mjs",
    "test:regression": "npm run test:availability && npm run test:stock && npm run test:tracking && npm run test:storage",
    "qa": "eslint . && tsc --noEmit && npm run test:regression && next build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "^4.3.0",
    "lucide-react": "^1.22.0",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.18",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "sharp": "0.35.3"
    }
  }
