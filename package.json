{
  "name": "tango-reservas",
  "version": "5.6.0-configuracion-lab",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:availability": "node scripts/availability-regression-tests.mjs",
    "test:stock": "node scripts/stock-regression-tests.mjs",
    "test:tracking": "node scripts/tracking-regression-tests.mjs",
    "test:storage": "node scripts/storage-contract-regression-tests.mjs",
    "test:backup": "node scripts/local-backup-regression-tests.mjs",
    "test:notifications": "node scripts/notification-settings-regression-tests.mjs",
    "test:regression": "npm run test:availability && npm run test:stock && npm run test:tracking && npm run test:storage && npm run test:backup && npm run test:notifications && npm run test:architecture && npm run test:database-security && npm run test:auth && npm run test:security-foundation && npm run test:dependency-security",
    "qa:prepare": "node scripts/prepare-qa.mjs && next typegen",
    "qa": "npm run qa:prepare && npm run security:scan && npm run security:env && eslint . && tsc --noEmit && npm run test:regression && next build",
    "test:architecture": "node scripts/architecture-regression-tests.mjs",
    "test:database-security": "node scripts/database-security-regression-tests.mjs",
    "test:auth": "node scripts/auth-ssr-regression-tests.mjs",
    "security:scan": "node scripts/security-static-scan.mjs",
    "security:env": "node scripts/security-env-check.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test:security-foundation": "node scripts/security-foundation-regression-tests.mjs",
    "test:dependency-security": "node scripts/dependency-security-regression-tests.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "^4.3.0",
    "lucide-react": "^1.22.0",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.0",
    "postcss": "8.5.18"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.18",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "next": {
      "sharp": "0.35.3"
    },
    "postcss": "$postcss"
  }
}
